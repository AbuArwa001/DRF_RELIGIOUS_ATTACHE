# Copy this file to .env and fill in your values
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,api.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Database (leave blank to use SQLite)
DATABASE_URL=

# Media files (local dev fallback — ignored when USE_S3=True)
MEDIA_ROOT=media/

# ── AWS S3 Storage ────────────────────────────────────────────────────────────
# IAM user: jmcDonation  |  Bucket: religionattche
USE_S3=False
AWS_STORAGE_BUCKET_NAME=religionattche
AWS_S3_REGION_NAME=us-east-1
AWS_ACCESS_KEY_ID=your-iam-access-key-id
AWS_SECRET_ACCESS_KEY=your-iam-secret-access-key
